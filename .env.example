# MigPAL — Configuración de entorno
# Copia este archivo a .env y ajusta los valores. `docker compose up` lee este
# .env automáticamente (Foundation, A-ADR-005: un solo comando, sin config manual).

# ============== Servicio ==============
SERVICE_NAME=migpal-backend
API_PREFIX=/api/v1
ENVIRONMENT=development

# ============== Base de datos ==============
# En Docker Compose, docker-compose.yml sobreescribe esto para apuntar a Postgres.
# Para correr el backend fuera de Docker (venv local), deja el default SQLite.
DATABASE_URL=sqlite:///./migpal.db
POSTGRES_PASSWORD=migpal_dev_password

# ============== Autenticación ==============
# OBLIGATORIO — sin default (SECURITY-001: nunca "change_me").
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET_KEY=
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============== IA — Kimi / Moonshot (proveedor por defecto) ==============
# API compatible con OpenAI. Doc: https://platform.kimi.ai/docs/api/chat
# Conseguí tu key en https://platform.moonshot.ai/ — NUNCA la commitees.
AI_PROVIDER=kimi
AI_MODEL=kimi-k2.6
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=2

# Nota sobre modelos de Kimi (verificado contra la API en vivo):
#  - kimi-k2.6 permite desactivar el razonamiento (thinking.type=disabled).
#    Es el recomendado para MigPAL: responde en ~4s y no gasta el
#    presupuesto de tokens pensando.
#  - kimi-k3 razona siempre; necesita max_tokens mucho más alto.
#  - `temperature` está restringido por modelo/modo y devuelve 400 si no es
#    el valor permitido — el cliente no lo envía a propósito.

# ============== IA — Ollama (proveedor alternativo, local) ==============
# Para volver al modelo local: AI_PROVIDER=ollama y AI_MODEL=migpal:latest
OLLAMA_URL=http://127.0.0.1:11434
AI_API_KEY=

# ============== Cache ==============
REDIS_URL=redis://localhost:6379/0

# ============== Telegram Bot ==============
# El token anterior quedó comprometido (SECURITY-001) — regenera vía @BotFather.
# Solo necesario para el servicio `telegram-bot` (profile "bot").
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ENABLED=true

# ============== Email (opcional) ==============
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@migpal.com
SMTP_FROM_NAME=MigPAL

# ============== Frontend ==============
FRONTEND_URL=http://localhost:3000

# ============== Logging estructurado ==============
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_FILE=

# ============== Integraciones opcionales ==============
ENABLE_EXTERNAL_SCRAPERS=false
GREAT_SCHOOLS_API_KEY=
