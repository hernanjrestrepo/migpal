# MigPAL Backend Configuration

# Service Configuration
SERVICE_NAME=migpal-backend
API_PREFIX=/api/v1

# Database
DATABASE_URL=sqlite:///./migpal.db

# Authentication
AUTH_SECRET_KEY=your-secret-key-here-change-in-production
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Assistant Configuration
# Choose one provider: anthropic, openai, or gemini
AI_PROVIDER=anthropic
AI_API_KEY=your-api-key-here
AI_MODEL=claude-3-5-sonnet-20241022

# Alternative AI Providers:
# For OpenAI:
# AI_PROVIDER=openai
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4

# For Gemini:
# AI_PROVIDER=gemini
# AI_API_KEY=...
# AI_MODEL=gemini-pro

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@migpal.com
SMTP_FROM_NAME=MigPAL

# Frontend URL
FRONTEND_URL=http://localhost:3000
