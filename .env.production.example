# =============================================================================
# MigPAL — plantilla de entorno de PRODUCCIÓN
# -----------------------------------------------------------------------------
# Copiar a `.env` en el servidor y completar. NUNCA commitear el archivo real
# (`*.env` está en .gitignore).
#
#   cp .env.production.example .env
#   nano .env
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
# =============================================================================

ENVIRONMENT=production
SERVICE_NAME=migpal-backend
API_PREFIX=/api/v1

# ============================ Base de datos ============================
# El host `postgres` es el nombre del servicio en docker-compose.
POSTGRES_PASSWORD=            # generar: openssl rand -base64 32
DATABASE_URL=postgresql://migpal:REEMPLAZAR_CON_POSTGRES_PASSWORD@postgres:5432/migpal

# ============================== Seguridad ==============================
# Obligatorio, mínimo 16 caracteres. El backend se niega a arrancar con un
# valor adivinable (ver docs/SECURITY-001.md).
#   generar: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET_KEY=
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Orígenes permitidos por CORS, separados por comas. En producción los
# orígenes de desarrollo NO se agregan solos.
# Si el frontend lo sirve el mismo nginx que el API, no hay cruce de origen
# y basta con el dominio público.
CORS_ORIGINS=https://migpal.tudominio.com
FRONTEND_URL=https://migpal.tudominio.com

# ================================= IA ==================================
# Kimi (Moonshot). Key en https://platform.moonshot.ai/
# Rotarla si alguna vez se compartió en texto plano.
AI_PROVIDER=kimi
AI_MODEL=kimi-k2.6
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=2

# ================================ Cache ================================
REDIS_URL=redis://redis:6379/0

# ================================ Logs =================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=

# ============================= Opcionales ==============================
# Email (verificación de cuenta). Sin esto, el registro funciona igual.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@tudominio.com
SMTP_FROM_NAME=MigPAL

# Bot de Telegram (generación anterior del producto, no requerido por la
# plataforma web). Dejar vacío salvo que se levante el profile `bot`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ENABLED=false

ENABLE_EXTERNAL_SCRAPERS=false
GREAT_SCHOOLS_API_KEY=
