# MigPAL Production Environment Configuration
# Version: v4.1-prod
# Date: 2026-01-09

# ============== DATABASE ==============
DATABASE_URL=sqlite:///./migpal.db

# ============== AI CONFIGURATION ==============
AI_PROVIDER=ollama
AI_MODEL=migpal:latest
OLLAMA_URL=http://127.0.0.1:11434
AI_TEMPERATURE=0.5

# ============== MIGPAL USA STANDARD v4.1 ==============
# PRODUCTION DEFAULT: ENABLED
# Set to 0 for legacy fallback if issues arise
MIGPAL_USA_STANDARD_V4=1

# v4.1 Features:
# - Hard cap: 6 líneas por mensaje
# - Hard rule: 1 pregunta por mensaje
# - Progress header: 100% (📍Fase X/12 • YY%)
# - Micro-check: cada 3 turnos
# - Mini-resumen: al cerrar cada fase

# ============== TELEGRAM BOT ==============
TELEGRAM_BOT_TOKEN=8243325921:AAFTkOmUG9emaDVa6dBPdxpey1rUxkSdLOA

# ============== MONITORING ==============
LOG_LEVEL=INFO
ENABLE_METRICS=true
METRICS_PORT=9090

# ============== FALLBACK CONFIGURATION ==============
# If v4.1 causes issues, set MIGPAL_USA_STANDARD_V4=0
# This will revert to legacy behavior without restart
# Middleware has safe_v4_call decorator for graceful fallback
