# Database
DATABASE_URL=sqlite:///./migpal.db

# Authentication
AUTH_SECRET_KEY=your_super_secret_jwt_key_change_in_production
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI
AI_PROVIDER=ollama
AI_MODEL=migpal
AI_API_KEY=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@migpal.com
SMTP_FROM_NAME=MigPAL

# Frontend
FRONTEND_URL=http://localhost:3000

# Scrapers / Integrations
ENABLE_EXTERNAL_SCRAPERS=false
GREAT_SCHOOLS_API_KEY=

# Service metadata
service_name=migpal-backend
api_prefix=/api/v1
